---
// All WordPress Pages (except the front page, served by index.astro).
// Mirrors the Gatsby page template: HeroHeader + content wrapped in the
// .soames-gatsby-content container. ORBI-52: the hero title/caption come from the
// dedicated WP hero fields (title falling back to the page title, caption showing
// nothing when unset); page.title/page.excerpt drive only the browser title and
// meta description now.
import Base from "@theme/layouts/Base.astro";
import HeroHeader from "@theme/components/HeroHeader";
import Shortcodes from "@theme/components/shortcodes/Shortcodes";
import RemoveContentAreaPadding from "@theme/components/shortcodes/RemoveContentAreaPadding";
import { getPages, resolveHeroBg, resolveHeroTitle, resolveHeroCaption } from "../lib/wp";

export async function getStaticPaths() {
  const pages = await getPages();
  return pages
    .filter(
      (page) =>
        page.uri && // skip the assigned Posts page (uri is null) — it would
        page.uri !== "/" && // crash page.uri.replace(); front page → index.astro
        !page.isPostsPage // the blog archive renders the Posts page, not here
    )
    .map((page) => {
      const clean = page.uri!.replace(/^\/+|\/+$/g, "");
      return { params: { uri: clean || undefined }, props: { page } };
    });
}

let { page } = Astro.props;

// Dev only: getStaticPaths (and the WP content it bakes into props) is cached for
// the life of `astro dev`, so edits in WordPress wouldn't show until a restart.
// Re-fetch the current page on each request in dev so a browser refresh reflects
// content changes. Tree-shaken out of production builds (import.meta.env.DEV).
if (import.meta.env.DEV) {
  const clean = (Astro.params.uri ?? "").replace(/^\/+|\/+$/g, "");
  const fresh = (await getPages()).find(
    (p) => (p.uri ?? "").replace(/^\/+|\/+$/g, "") === clean
  );
  if (fresh) page = fresh;
}
---
<Base pageTitle={page.title} description={page.excerpt}>
  <HeroHeader
    title={resolveHeroTitle(page)}
    subhead={resolveHeroCaption(page)}
    backgroundImage={resolveHeroBg(page)}
    overlayOpacity={page.overlayOpacity}
  />
  {page.content && (
    <section id="soames-gatsby-content-container" class="soames-gatsby-content">
      <RemoveContentAreaPadding />
      <Shortcodes html={page.content} />
    </section>
  )}
</Base>
