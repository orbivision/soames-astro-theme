---
// Single documentation page (weDocs `docs` CPT). Mirrors the blog post template:
// HeroHeader + two columns — article content (left) and a hierarchical menu of
// all doc pages (right), instead of the blog's "Recent Posts". Content is run
// through the same shortcode parser as posts/pages.
import Base from "@theme/layouts/Base.astro";
import HeroHeader from "@theme/components/HeroHeader";
import Shortcodes from "@theme/components/shortcodes/Shortcodes";
import DocsSidebar from "@theme/components/DocsSidebar";
import DocsSearch from "@theme/components/DocsSearch";
import Breadcrumbs from "@theme/components/Breadcrumbs";
import {
  getDocs,
  buildDocTree,
  getDocsPage,
  docAncestors,
  resolveHeroBg,
  resolveHeroTitle,
  resolveHeroCaption,
} from "../../lib/wp";

export async function getStaticPaths() {
  // Derive the [...slug] param from the doc's WP uri (e.g. /docs/getting-started/
  // → "getting-started", /docs/guide/install/ → "guide/install"). Skip the empty
  // slug — /docs/ is the landing page (docs/index.astro). Defined inside
  // getStaticPaths: Astro evaluates this fn in isolation from the frontmatter.
  const toSlug = (uri: string) =>
    uri.replace(/^\/+|\/+$/g, "").replace(/^docs\/?/, "");

  const docs = await getDocs();
  const tree = buildDocTree(docs);
  // Single docs inherit the /docs/ page hero — title, caption, background image,
  // overlay — falling back to "Documentation" / placeholder when none is set.
  // Fetched once here and shared across all paths (one WP round-trip).
  const docsPage = await getDocsPage();
  const heroTitle = resolveHeroTitle(docsPage, "Documentation");
  const heroCaption = resolveHeroCaption(docsPage);
  const heroBg = resolveHeroBg(docsPage);
  const heroOverlay = docsPage?.overlayOpacity ?? null;
  // The breadcrumb crumb for /docs/ keeps the docs page's REAL title — it labels a
  // destination, so it must not follow a custom hero title (ORBI-52).
  const docsLabel = docsPage?.title ?? "Documentation";
  return docs
    .map((doc) => ({ doc, slug: toSlug(doc.uri) }))
    .filter(({ slug }) => slug.length > 0)
    .map(({ doc, slug }) => ({
      params: { slug },
      props: { doc, docs, tree, heroTitle, heroCaption, heroBg, heroOverlay, docsLabel },
    }));
}

let { doc, docs, tree, heroTitle, heroCaption, heroBg, heroOverlay, docsLabel } = Astro.props;

// Dev only: re-fetch on each request so WP doc edits show on refresh without
// restarting `astro dev` (getStaticPaths props are cached otherwise). Stripped
// from production builds (import.meta.env.DEV).
if (import.meta.env.DEV) {
  const toSlug = (uri: string) => uri.replace(/^\/+|\/+$/g, "").replace(/^docs\/?/, "");
  docs = await getDocs();
  const fresh = docs.find((d) => toSlug(d.uri) === Astro.params.slug);
  if (fresh) {
    doc = fresh;
    tree = buildDocTree(docs);
  }
  const dp = await getDocsPage();
  heroTitle = resolveHeroTitle(dp, "Documentation");
  heroCaption = resolveHeroCaption(dp);
  heroBg = resolveHeroBg(dp);
  heroOverlay = dp?.overlayOpacity ?? null;
  docsLabel = dp?.title ?? "Documentation";
}

// Breadcrumb trail: Home › <docs landing> › <ancestors…> › current (plain text).
// Ancestors come from the parentDatabaseId chain (data, not the URI).
const crumbs = [
  { label: "Home", href: "/" },
  { label: docsLabel, href: "/docs/" },
  ...docAncestors(docs, doc.databaseId).map((a) => ({ label: a.title, href: a.uri })),
  { label: doc.title },
];
---
<Base pageTitle={doc.title} description={doc.excerpt}>
  <HeroHeader title={heroTitle} subhead={heroCaption} backgroundImage={heroBg} overlayOpacity={heroOverlay} />
  <section>
    <div class="media-container-row">
      <div class="col-12 col-lg-8">
        <section id="soames-gatsby-content-container" class="soames-gatsby-blog-content">
          <article class="blog-post soames-prose" itemscope itemtype="http://schema.org/TechArticle">
            <header>
              <Breadcrumbs crumbs={crumbs} />
              <h1 itemprop="headline">{doc.title}</h1>
            </header>
            {doc.content && (
              <section itemprop="articleBody" class="blog-post-content">
                <Shortcodes html={doc.content} prose />
              </section>
            )}
          </article>
        </section>
      </div>
      <div class="col-12 col-lg-4">
        <section id="soames-gatsby-sidebar-container" class="soames-gatsby-sidebar">
          <DocsSearch client:idle />
          <DocsSidebar tree={tree} currentId={doc.databaseId} />
        </section>
      </div>
    </div>
  </section>
</Base>
