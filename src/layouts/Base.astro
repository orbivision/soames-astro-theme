---
// Soames theme base layout. Header & Footer are imported through `@theme/` so a
// site can shadow them via src/overrides/. All WordPress data is fetched at build
// time here (replaces Gatsby useStaticQuery) and passed down as props.

// Global styles (cascade order matches the Gatsby setup: vendor → theme → overrides).
import "bootstrap/dist/css/bootstrap.min.css";
import "../styles/vendor/wordpress-blocks.css";
import "../styles/theme.css"; // @imports soames/{base,layout,typography,components,overrides}
// Site global overrides — empty in the theme; a site shadows this via
// src/overrides/styles/site-overrides.css. Imported LAST so site rules win.
import "@theme/styles/site-overrides.css";

import Header from "@theme/components/Header";
import Footer from "@theme/components/Footer";
import {
  getGeneralSettings,
  getSoamesSettings,
  getMenuByLocation,
} from "../lib/wp";
import { htmlToText, truncateAtWord } from "../lib/text";
import { isKestrel } from "../lib/optimaExpress";

interface Props {
  pageTitle: string;
  /**
   * Raw WordPress excerpt/HTML is fine here — it is stripped to plain text and
   * length-capped for the meta description (ORBI-68). Markup passed in CANNOT
   * survive, by design: a meta description must be plain text.
   */
  description?: string;
  isHomePage?: boolean;
  /**
   * ORBI-82: this page needs Optima Express's Kestrel loader — an IDX shell, or WordPress
   * content that embeds a widget (see usesKestrel). Ignored unless the WP site has Optima
   * Express active, registered and in Kestrel mode.
   */
  kestrel?: boolean;
  /** `false` suppresses the canonical (an IDX shell serves many URLs; its own is unknown). */
  canonical?: false;
  /** Meta robots, e.g. "noindex" for IDX account pages. Omitted when unset. */
  robots?: string;
}
const { pageTitle, description, isHomePage = false, kestrel = false, canonical, robots } = Astro.props;

const [settings, soames, headerMenu, footerMenu] = await Promise.all([
  getGeneralSettings(),
  getSoamesSettings(),
  getMenuByLocation("HEADER"),
  getMenuByLocation("FOOTER"),
]);

// ORBI-68. Two defects this replaces: WP excerpts arrive as HTML, so descriptions
// emitted raw `<p>…`; and the WP tagline (settings.description) is blank on some
// installs, so any route that passes no description emitted an EMPTY one.
// Decode-then-truncate order matters — see truncateAtWord.
// The last resort is derived rather than hardcoded copy: the theme ships to sites
// whose subject matter it cannot know, and `pageTitle` is a required prop, so this
// can never resolve to "". That guarantee is what keeps the e2e assertion in
// soames-site honest — an absent meta fails Playwright by timeout, not assertion.
const metaDescription =
  truncateAtWord(htmlToText(description ?? "")) ||
  truncateAtWord(htmlToText(settings.description ?? "")) ||
  truncateAtWord(htmlToText(`${pageTitle} — ${settings.title}`));
const fullTitle = `${pageTitle} | ${settings.title}`;

// ORBI-82 decision A: a canonical only for a site that passed `siteUrl` to the theme
// explicitly, so sites that haven't opted in keep byte-identical output.
const siteUrl = import.meta.env.SOAMES_SITE_URL as string;
const canonicalUrl = siteUrl && canonical !== false ? new URL(Astro.url.pathname, siteUrl).href : null;

// Loaded synchronously in <head>: widgets call ihfKestrel.render() inline while the page
// parses. It's ~770 KB, so only on pages that use it (decision B). The activationToken is
// public by design — WordPress prints it in every page Optima Express renders.
const oe = soames.optimaExpress;
const kestrelConfig =
  kestrel && isKestrel(oe)
    ? `window.ihfKestrel = window.ihfKestrel || {}; ihfKestrel.config = ${JSON.stringify(oe.kestrel).replace(/</g, "\\u003c")};`
    : null;
const showCompanyName = soames.showCompanyName ?? true;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {metaDescription && <meta name="description" content={metaDescription} />}
    {robots && <meta name="robots" content={robots} />}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {/* SEO/OG/Twitter — replaces the Gatsby Seo (react-helmet) component */}
    <meta property="og:title" content={pageTitle} />
    {metaDescription && <meta property="og:description" content={metaDescription} />}
    <meta property="og:type" content="website" />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    {metaDescription && <meta name="twitter:description" content={metaDescription} />}
    {soames.faviconUrl && <link rel="icon" href={soames.faviconUrl} type="image/png" />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Rubik:ital,wght@0,300;0,400;0,500;0,700;0,900;1,300;1,400;1,500;1,700;1,900&display=swap"
    />
    {kestrelConfig && <script is:inline set:html={kestrelConfig} />}
    {kestrelConfig && <script is:inline src="https://kestrel.idxhome.com/ihf-kestrel.js"></script>}
  </head>
  <body>
    {/* `.global-wrapper` matches the Gatsby Layout structure. Crucially, the theme
        CSS makes <main> the parallax scroll container (height:100vh; overflow-y:auto;
        perspective:2px), so EVERYTHING that scrolls — content AND footer — must live
        INSIDE <main>, exactly as the Gatsby layout had it. */}
    <div class="global-wrapper" data-is-root-path={isHomePage}>
      <Header
        title={settings.title}
        logoUrl={soames.logoUrl}
        logoAlt={soames.logoAlt}
        companyName={soames.companyName}
        showCompanyName={showCompanyName}
        menuItems={headerMenu}
      />
      <main>
        <slot />
        <Footer
          title={settings.title}
          contactBlurb={soames.contactBlurb}
          companyName={soames.companyName}
          menuItems={footerMenu}
        />
      </main>
    </div>
    {/* Bootstrap 5 bundle (Popper included, no jQuery) handles the mobile
        hamburger collapse; soames-nav.js covers submenu dropdowns + scroll state. */}
    <script>
      import "bootstrap/dist/js/bootstrap.bundle.min.js";
      import "../scripts/soames-nav.js";
    </script>
  </body>
</html>
